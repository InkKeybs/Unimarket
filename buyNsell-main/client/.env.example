# Example .env for the client
# Copy this to .env and set the backend base URL used by the React app

# Example for local development:
REACT_APP_BASEURL=http://localhost:5000

# Merchant GCash QR image for the checkout page.
# Example:
# REACT_APP_GCASH_QR_CODE_URL=/gcash-qr.png
# Put the image file in client/public/gcash-qr.png, or set any other public URL path here.
REACT_APP_GCASH_QR_CODE_URL=

# Optional merchant display details.
REACT_APP_GCASH_ACCOUNT_NAME=
REACT_APP_GCASH_NUMBER=
